<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="@dimen/page_margin">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/hero_eyebrow" android:textColor="@color/mint"
                android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small" android:text="@string/hero_title"
                android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small" android:text="@string/hero_description"
                android:textColor="@color/mint" android:textSize="14sp" />
        </LinearLayout>
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_medium"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/login_heading" android:textColor="@color/ink"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/login_caption"
                android:textColor="@color/secondary_text" android:textSize="13sp" />
            <EditText
                android:id="@+id/edtStudentId"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="@dimen/gap_medium"
                android:background="@drawable/bg_input"
                android:hint="@string/student_id_hint"
                android:inputType="textCapCharacters"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:singleLine="true" android:textColor="@color/ink"
                android:textColorHint="@color/secondary_text" android:textSize="15sp" />
            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="@dimen/gap_small"
                android:background="@drawable/bg_input"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:singleLine="true" android:textColor="@color/ink"
                android:textColorHint="@color/secondary_text" android:textSize="15sp" />
            <CheckBox
                android:id="@+id/cbRemember"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:buttonTint="@color/forest" android:text="@string/remember_me"
                android:textColor="@color/secondary_text" android:textSize="13sp" />
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="@dimen/gap_small"
                android:background="@drawable/bg_button" android:text="@string/login_button"
                android:textColor="@color/white" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small" android:gravity="center"
                android:text="@string/demo_notice" android:textColor="@color/secondary_text"
                android:textSize="11sp" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_medium" android:layout_weight="1"
            android:orientation="vertical">
            <include layout="@layout/view_profile_card" />
        <Button android:id="@+id/btnConstraintDemo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_medium"
            android:backgroundTint="@color/mint" android:text="@string/layout_button"
            android:textColor="@color/forest" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
